# ===========================================
# CONFIGURAÇÃO DO SERVIDOR LINKROTATOR
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Fuso horário do Brasil (IMPORTANTE: não alterar)
TZ=America/Sao_Paulo

# Porta do servidor
PORT=3000

# URL do seu site (para CORS)
FRONTEND_URL=https://seudominio.com

# ===========================================
# FIREBASE (Service Account)
# ===========================================
# Baixe o JSON em: Firebase Console > Engrenagem > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=linkrotator-2bae9
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@linkrotator-2bae9.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# ===========================================
# POSTGRESQL
# ===========================================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=linkrotator_db
PG_USER=linkrotator
PG_PASSWORD=SUA_SENHA_AQUI

# ===========================================
# META ADS API
# ===========================================
# 1. Acesse developers.facebook.com
# 2. Crie um app do tipo "Business"
# 3. Adicione o produto "Marketing API"
# 4. Vá em Tools > Graph API Explorer
# 5. Gere um token com permissões: ads_read, ads_management
# 6. Cole o token abaixo

META_ACCESS_TOKEN=SEU_TOKEN_META_AQUI
META_AD_ACCOUNT_ID=act_123456789
META_APP_ID=123456789
META_APP_SECRET=abc123def456

# ===========================================
# EVOLUTION API (WhatsApp)
# ===========================================
# 1. Instale a Evolution API v2: https://doc.evolution-api.com
# 2. Copie a URL e a API Key (AUTHENTICATION_API_KEY) geradas na instalação
# 3. O nome da instância será criado automaticamente se não existir
#
# A EVOLUTION_API_KEY é a mesma AUTHENTICATION_API_KEY configurada
# na sua Evolution API. Ex: Se na Evolution API você configurou
# AUTHENTICATION_API_KEY=SuaChaveSecretaAqui, use esse valor abaixo.

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=SuaChaveSecretaAqui
EVOLUTION_INSTANCE_NAME=linkrotator

# (Opcional) URL pública do webhook - OBRIGATÓRIO se seu servidor
# estiver atrás de proxy/domínio. A Evolution API precisa conseguir
# enviar eventos para esta URL.
# Se não configurado, usa http://localhost:PORT automaticamente
# EVOLUTION_WEBHOOK_URL=https://seudominio.com
